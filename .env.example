# MongoDB Atlas M0 connection string (URL-encode special characters in password)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=whitecard

# Envelope Encryption Master Key: 64 hex characters (32 bytes). Generate with `npm run gen-keys`
MASTER_KEY=

# Ed25519 Share Token Signing Private Key: base64 PKCS8 format. Generate with `npm run gen-keys`
SIGNING_PRIVATE_KEY=
SIGNING_KEY_ID=key-1

# Application Base URL
APP_URL=http://localhost:3000

# WebAuthn Relying Party Configuration
RP_ID=localhost
RP_NAME=White Card Wallet

# Transactional Email Provider: "resend" or "brevo"
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Secret guarding /api/cron/* endpoints. Generate with `npm run gen-keys`
CRON_SECRET=
